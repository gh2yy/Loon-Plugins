#!name = 快手去红包挂件
#!desc = 去掉视频页左侧的红包挂件（看视频挂件）：清空 unionTask/startup 下发的 widgetList。点红包打开的任务中心本身不受影响，从「我」页等正常入口仍可进入。
#!author = gh2yy
#!date = 2026-11-06
#!tag = 快手,界面

# 修改日志：
# - 2026-11-06 Muse：首版。定位（快手 14.9.10.10022、Loon 抓包 354 + 录屏）：红包挂件由冷启动接口 POST /rest/n/encourage/unionTask/startup 的 data.widgetInfo.widgetList 唯一一条 WATCH_PHOTO 挂件下发——样式 RP（红包）、初始位置左侧 y=133、跳转 encourage.kuaishou.com/kwai/task?source=pendant（任务中心），与录屏逐项对上；全量抓包无第二处下发。脚本 Kuaishou-loon.js 只清空 widgetList，其余字段原样保留，解析失败原样放行。本地用抓包原响应验证：widgetList 1→0、其余字段 JSON 层逐一等价，异常输入 4 项全过。待用户真机实测。
#
# 实测要点：装后杀快手冷启动（挂件配置是冷启动预取的，热切回来不会刷新）；若红包还在，保持插件启用再抓一份冷启动包发回，先确认改写是否送达，再谈内容。

[Script]
http-response ^https:\/\/az1-api\.ksapisrv\.com\/rest\/n\/encourage\/unionTask\/startup(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Kuaishou-loon.js, requires-body=true, timeout=10, tag=快手-去红包挂件

[Mitm]
hostname = az1-api.ksapisrv.com
