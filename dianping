[Rewrite]
# 搜索页「搜索发现」
request if ${url} ~= /^https:\/\/mapi\.dianping\.com\/mapi\/searchdirectsuggest\.bin/i then reject(404)
# 搜索页「点评热点」
request if ${url} ~= /^https:\/\/mapi\.dianping\.com\/mapi\/hotsuggest\.bin/i then reject(404)
# 开屏广告配置（预下载入口，http/https 均拦）
request if ${url} ~= /^https?:\/\/mapi\.dianping\.com\/mapi\/operating\/loadsplashconfig\.bin/i then reject(404)

[Script]
# 首页右上角签到/金币入口（homeframe 根部秒杀权益对象）
http-response ^https?:\/\/mapi\.dianping\.com\/mapi\/dphomepage\/homeframe\.bin script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/dianping-home.js?v=4, requires-body=true, binary-body-mode=true, tag=点评-去首页签到入口
# 金刚区下方「点评榜单/免费试」运营位（indexmodules 运营位数组）
http-response ^https?:\/\/mapi\.dianping\.com\/mapi\/dphomepage\/indexmodules\.bin script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/dianping-home.js?v=4, requires-body=true, binary-body-mode=true, tag=点评-去点评榜单免费试
# 「我的」页四宫格（mytabfeedpromotev2 的 promotes 数组四项）
http-response ^https?:\/\/mapi\.dianping\.com\/mapi\/mytabfeedpromotev2\.bin script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/dianping-home.js?v=4, requires-body=true, binary-body-mode=true, tag=点评-去我的页四宫格
# 「我的」页笔记达人中心整节（getmytabelementsv2 的 list 元素 + noteList）
http-response ^https?:\/\/mapi\.dianping\.com\/mapi\/getmytabelementsv2\.bin script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/dianping-home.js?v=4, requires-body=true, binary-body-mode=true, tag=点评-去笔记达人中心
# 「我的」页底部「我的收藏/最近浏览」整段（halo 键 my_favor_history）
http-response ^https?:\/\/mapi\.dianping\.com\/mapi\/halo\/halo\.newparam script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/dianping-halo.js?v=2, requires-body=true, tag=点评-去收藏浏览区

[Mitm]
hostname = mapi.dianping.com
