# 修改日志：
# - 2026-11-02 Muse：由 ZenmoFeiShi 的 QX 版 txsports-ad-clean（原版 2026-11-1）逐条转 Loon。8 条 http-response 规则与 Mitm 与原版一一对应，UA（QQSportsV3）门控在脚本内部判断、与原版一致。脚本须适配：原版 GetTabRemoteConfig（protobuf）分支用 QX 专属 $response.bodyBytes 读、$done({bodyBytes}) 回，在 Loon 下静默无效；仓库 Txsports-loon.js 为适配版（改读 $response.body、回 {body}，状态码兼容 status），该条规则须开 binary-body-mode，其余 7 条为文本模式不可开（开了 JSON 分支会因 body 非字符串而失效）。业务逻辑未动，本地 Node 模拟 19 项全过（含与 QX 原版输出逐字节一致、原版在 Loon 环境 no-op 对照）。

[Script]
http-response ^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txsports-loon.js, requires-body=true, binary-body-mode=true, timeout=30, tag=腾讯体育-tab配置去开屏
http-response ^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txsports-loon.js, requires-body=true, timeout=10, tag=腾讯体育-关广告SDK
http-response ^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txsports-loon.js, requires-body=true, timeout=10, tag=腾讯体育-去底部会员入口
http-response ^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txsports-loon.js, requires-body=true, timeout=10, tag=腾讯体育-我的页精简
http-response ^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txsports-loon.js, requires-body=true, timeout=10, tag=腾讯体育-直播计数清零
http-response ^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txsports-loon.js, requires-body=true, timeout=10, tag=腾讯体育-赛事更新精简
http-response ^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txsports-loon.js, requires-body=true, timeout=10, tag=腾讯体育-首页去广告与热词
http-response ^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txsports-loon.js, requires-body=true, timeout=10, tag=腾讯体育-SSP广告清空

[Mitm]
hostname = config.ab.qq.com, k.ssp.qq.com, app.sports.qq.com, sports.ssp.qq.com
