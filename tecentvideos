#!name = 腾讯视频净化 v3
#!desc = 去开屏/片头广告、底部多余 tab 等
#!author = ZenmoFeiShi（TG @ZenMoFiShi）
#!date = 2026-10-27
#!tag = 腾讯视频,去广告,界面净化

# 修改日志：
# - 2026-10-27 Muse：由 QX 版 TxvideoAD.snippet 转为 Loon 格式：新增拦 QUIC 的 UDP 规则、脚本匹配放宽、超时 30 秒；脚本改指自托管适配版 Txvideoad-loon.js（修复 QX 专属 bodyBytes 在 Loon 下不生效，另含热启动开屏补丁）；同日同步上游更新（暂停广告、信息流瀑布流广告清理）。

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT
AND,((DOMAIN,i.video.qq.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,iacc.qq.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,config.ab.qq.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,rdelivery.qq.com),(PROTOCOL,UDP)),REJECT

[Script]
http-request ^https?:\/\/i\.video\.qq\.com\/.* script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txvideoad-loon.js, requires-body=true, binary-body-mode=true, timeout=30, tag=腾讯视频-请求拦广告函数
http-response ^https?:\/\/i\.video\.qq\.com\/.* script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txvideoad-loon.js, requires-body=true, binary-body-mode=true, timeout=30, tag=腾讯视频-响应清广告和底部tab
http-response ^https?:\/\/iacc\.qq\.com\/.* script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txvideoad-loon.js, requires-body=true, binary-body-mode=true, timeout=30, tag=腾讯视频-JCE去广告
http-response ^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txvideoad-loon.js, requires-body=true, binary-body-mode=true, timeout=30, tag=腾讯视频-底部tab精简配置
http-response ^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/Txvideoad-loon.js, requires-body=true, tag=腾讯视频-关闭tab_gray

[MITM]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
