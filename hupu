http-response ^https?:\/\/goblin\.hupu\.com\/.*interfaceAd\/getOther\/.* script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/hupu.js?v=8, requires-body=true, timeout=10, tag=虎扑-去广告含开屏-响应兜底
http-response ^https?:\/\/bbs\.mobileapi\.hupu\.com\/.*\/threads\/refactor\/.* script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/hupu.js?v=8, requires-body=true, timeout=10, tag=虎扑-去问深聊
http-response ^https?:\/\/bbs\.mobileapi\.hupu\.com\/.*bbsallapi\/recommend\/v2\/getRecommendList script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/hupu.js?v=8, requires-body=true, timeout=10, tag=虎扑-去游戏推广卡
http-response ^https?:\/\/games\.mobileapi\.hupu\.com\/.*bbsallapi\/recommend\/v2\/getRecommendList script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/hupu.js?v=8, requires-body=true, timeout=10, tag=虎扑-去游戏推广卡-games域名
http-response ^https?:\/\/games\.mobileapi\.hupu\.com\/[^\/]+\/[^\/]+\/bplapi\/device\/v1\/init script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/hupu.js?v=8, requires-body=true, timeout=10, tag=虎扑-去首页热榜
http-response ^https?:\/\/games\.mobileapi\.hupu\.com\/[^\/]+\/[^\/]+\/bplapi\/device\/v1\/frontendofflinepkg\/upgradeListByCodes script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/hupu.js?v=8, requires-body=true, timeout=10, tag=虎扑-详情包换黑包
