# 修改日志：
# - 2026-10-30 Muse：按群友投稿转 Loon 插件。原稿是他方 mock 写法，转为 Loon 的 [Rule]+[Script] 形式：goblin.hupu.com 直连，interfaceAd/getOther 命中时由 hupu.js 直接回投稿的空广告 JSON（ad_code=-41、show_type=0、ads 空数组，状态 200）。投稿覆盖面仅此一个接口，如仍有其他广告需另抓包定位。

[Rule]
DOMAIN-SUFFIX,goblin.hupu.com,DIRECT

[Script]
http-response ^https?:\/\/goblin\.hupu\.com\/\d+\/[\d.]+\/interfaceAd\/getOther\/ script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/hupu.js, requires-body=true, timeout=10, tag=虎扑-去广告

[Mitm]
hostname = goblin.hupu.com
