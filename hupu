http-response ^https?:\/\/games\.mobileapi\.hupu\.com\/[^\/]+\/[^\/]+\/basketballapi\/news\/v3\/tab script-path=https://raw.githubusercontent.com/gh2yy/Loon-Plugins/main/hupu.js?v=8, requires-body=true, timeout=10, tag=虎扑-NBA入口精简

[Rewrite]
^https?:\/\/api-access\.pangolin-sdk-toutiao\d?\.com\/api\/ad\/union\/sdk\/get_ads\/.* reject-200

# 热启动白屏实验（本插件自有，非树先生规则）：config/app 下发的广告 SDK 启动超时组压到 100ms，验证白屏是否随之缩短，未定论可撤
^https:\/\/goblin\.hupu\.com\/\d\/\d\.\d\.\d+\/config\/app response-body-json-jq '.data.boot_pre_timeout = 100 | .data.flow_pre_timeout = 100 | .data.gdt_timeout_boot = 100 | .data.tt_timeout = 100 | .data.tt_timeout_boot = 100 | .data.xm_timeout_boot = 100 | .data.ylh_sdk_timeout_boot = 100 | .data.ylh_sdk_timeout_flow = 100 | .data.huawei_timeout = 100 | if .data.sdkTimeOutList then .data.sdkTimeOutList |= map(if .dspTimeOutList then .dspTimeOutList |= map(.ms = 100) else . end) else . end'

# —— 以下融合自树先生（ishowshu/loon）的虎扑插件，接口均已用 8.2.70 抓包核对 ——
# 我的页面游戏栏目
^https:\/\/fairy\.mobileapi\.hupu\.com\/gallery\/getmod2 reject-dict
# 搜索框提示词
^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/search\/v2\/hintkeylist reject-dict
# 专区tab最近浏览
^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/users\/browse\/topics reject-dict
# 话题榜
^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/tag\/v1\/heatTag reject-dict
# 评分榜
^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsrankapi\/bff\/v1\/rating\/list reject-dict
# 我的页面vip推广（并补删 redVipInfo 红单会员——树先生原规则未覆盖，抓包里为独立字段）
^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bplapi\/user\/v1\/more response-body-json-jq 'del(.result.inviteInfo, .result.vipInfo, .result.redVipInfo)'
# 推荐页横幅广告
^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/buffer\/hotList response-body-json-jq '.result.topBanner = []'
# 专区顶部横幅
^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/topics\/\d response-body-json-jq '.data.topicResources = []'
# 专区推荐tab
^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/topics\/topicSquareDetail response-body-json-jq '.data.list |= map(select(.cate_id != -99))'
# 我的页面底部菜单（并补删 advertisement 广告卡）
^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/lego\/data response-body-json-jq '.data.cards |= map(select(.code != "multiIcon" and .code != "advertisement"))'
# NBA页签到活动（并补删 adBanner 广告组件）
^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bplbffapi\/device\/v1\/nav\/content response-body-json-jq '.result.components |= map(select(.order != 5 and .code != "adBanner"))'
# 虎扑广场顶部话题
^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/tab\/cardModule response-body-json-jq '.data = {}'

[Mitm]
hostname = games.mobileapi.hupu.com, w1.hoopchina.com.cn, bbs.mobileapi.hupu.com, goblin.hupu.com, fairy.mobileapi.hupu.com, bbsrankapi.hupu.com, api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com
