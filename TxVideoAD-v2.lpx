#!name = 腾讯视频净化 v2
#!desc = 由 Quantumult X 的 TxvideoAD.snippet 转换 v2：去开屏广告、视频播放前广告、底部多余 tab 栏、我的页面美化。原作者 TG@ZenMoFiShi，原版更新 2026-10-27。v1 实测完全没作用，v2 针对“脚本根本没被触发”加了拦 QUIC、放宽匹配、拉长超时。
#!author = TG@ZenMoFiShi
#!date = 2026-10-27
#!tag = 腾讯视频,去广告,界面净化

# v2 改了什么（相对 v1，其余与原版逐条对应不变）
# 1. [Rule] 新增 4 条 AND,((DOMAIN,...),(PROTOCOL,UDP)),REJECT：拦掉 4 个 MITM 域名上的 QUIC/UDP。
#    原因：腾讯视频默认走 QUIC 时流量是 UDP，Loon 的 MITM/脚本只处理 TCP 上的 HTTP，脚本再对也触发不了；
#    原脚本本想靠改 AB 配置关 QUIC，但那份配置本身也要先被脚本改到、且有本地缓存，是先有鸡还是先有蛋。
#    拦 UDP 是 Loon 圈的标准打法（如 RuCu6 的 YouTube 插件同样 AND+PROTOCOL,UDP REJECT 逼回 TCP）。逼 App 回落 TCP 后脚本才有机会跑。
# 2. i.video.qq.com / iacc.qq.com 两条匹配由“仅根路径 /”放宽为“任意路径 /.*”：
#    原 QX 正则只匹配 https://i.video.qq.com/ (+可选 query)。若当前 iOS 版实际请求带路径，v1 会一条都命中不了。
#    放宽是安全的：脚本自己会验 TRPC 帧头 / JCE 结构 / 广告标记，不符合的 body 一律原样放行，多触发只是多跑几次空转。
# 3. 二进制脚本 timeout 由默认拉到 30 秒：Txvideoad.js 要在 JS 里做 gzip 解压 + 全文扫描标记，冷启动大包时默认超时可能直接被掐断回原包。
# 4. [MITM] 改大写写法（与主流 Loon 插件一致），hostname 内容仍是原版 4 个、未扩。
#
# 没变的
# - [Rule] 原版 2 条 DOMAIN REJECT（iacc.stgw.qq.com / tacc.video.qq.com）
# - 5 条脚本仍共用原作者远程 Txvideoad.js，未改一行；config.ab 的 GetTabRemoteConfig 与 rdelivery 的 sdkconfig/get 仍按原版精确路径匹配（这两条路径是确定的）。
#
# 注意
# - 装 v2 前先把 v1 删除或禁用，两版脚本叠加会对同一 body 重复处理。
# - 装后必须彻底杀掉腾讯视频再冷启动；底部 tab / simple_mode 配置有本地缓存，只热切换页面看不出来。
# - 若 v2 仍完全没作用，不要再猜：回传一份冷启动 30-60 秒的 Loon 日志即可定案（看 i.video 有没有出现、走 TCP 还是 UDP、脚本有没有触发/报错）。

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT
AND,((DOMAIN,i.video.qq.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,iacc.qq.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,config.ab.qq.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,rdelivery.qq.com),(PROTOCOL,UDP)),REJECT

[Script]
http-request ^https?:\/\/i\.video\.qq\.com\/.* script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, binary-body-mode=true, timeout=30, tag=腾讯视频-请求拦广告函数
http-response ^https?:\/\/i\.video\.qq\.com\/.* script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, binary-body-mode=true, timeout=30, tag=腾讯视频-响应清广告和底部tab
http-response ^https?:\/\/iacc\.qq\.com\/.* script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, binary-body-mode=true, timeout=30, tag=腾讯视频-JCE去广告
http-response ^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, binary-body-mode=true, timeout=30, tag=腾讯视频-底部tab精简配置
http-response ^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$ script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, tag=腾讯视频-关闭tab_gray

[MITM]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
